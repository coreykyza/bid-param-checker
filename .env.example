# ============================================================
# 模型配置模板（复制为 .env 后填入真实 key）
#    cp .env.example .env
# ============================================================

# ---------- 方案 A：火山引擎 Ark（当前在用，推荐） ----------
LLM_PROVIDER=custom
LLM_API_KEY=你的火山引擎key（形如 ark-xxxxxxxx-xxxx-...）
LLM_MODEL=deepseek-v4-1-flash-economy-261017
# 自动路由：按池顺序调用，某模型 429/额度耗尽自动拉黑并切下一个，不用手动换。
# 拉黑状态写 model_deadlist.json，重启服务后仍有效；不填则用上面的 LLM_MODEL 单模型。
LLM_MODEL_POOL=deepseek-v4-1-flash-economy-261017,deepseek-v4-flash-ga-260731,glm-5-3-flash-260828,deepseek-v4-pro-ga-260813,glm-5-2-260617,doubao-seed-evolving
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 关思考模式：实测 3.2s→1.3s，判定质量不变
LLM_THINKING=disabled
# AI 核验专家（异构复核）：核验也有独立池，550 万免费池放首位兜底
LLM_VERIFY_MODEL=doubao-seed-evolving
LLM_VERIFY_POOL=doubao-seed-evolving,deepseek-v4-pro-ga-260813,glm-5-3-flash-260828

# ---------- 方案 B：DeepSeek 官方 ----------
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线，须用 deepseek-flash
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled

# ---------- 方案 C：智谱（免费但能力弱） ----------
# LLM_PROVIDER=zhipu
# LLM_API_KEY=你的智谱key
# LLM_MODEL=glm-4-flash

# ---------- 方案 D：其他 OpenAI 兼容（通义/Kimi/自建） ----------
# LLM_PROVIDER=custom
# LLM_API_KEY=xxx
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 通用 ----------
LLM_MAX_TOKENS=8192
PORT=8765

# 兼容说明：老变量 ZHIPU_API_KEY / ZHIPU_MODEL 仍然有效
# 优先级：LLM_* > DEEPSEEK_* > ZHIPU_*
