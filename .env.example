# ============================================================
# 模型配置模板（复制为 .env 后填入真实 key）
#    cp .env.example .env
# ============================================================

# ---------- 方案 A：多 provider 免费额度混合路由（当前在用，推荐） ----------
# 主 provider = 火山；附加 provider = 阿里云百炼（可选，填了才启用）。
# 池条目 `tag:model` 走附加 provider，无前缀走主 provider。
# 自动路由：按池顺序调用，429/403 额度耗尽自动拉黑切下一个，不填则用 LLM_MODEL 单模型。
LLM_PROVIDER=custom
LLM_API_KEY=你的火山引擎key（形如 ark-xxxxxxxx-xxxx-...）
LLM_MODEL=deepseek-v4-1-flash-economy-261017
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_THINKING=disabled
# 附加 provider：阿里云百炼（不填则只用火山）
# LLM_BAILIAN_API_KEY=sk-你的百炼key
# LLM_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BAILIAN_THINKING=disabled
# kimi 专属：temperature=0.6 + thinking disabled，否则 content 空
# LLM_BAILIAN_KIMI_THINKING=kimi
# 初判池：建议把快到期的免费模型排前面先用掉，火山作为无到期日后备
LLM_MODEL_POOL=deepseek-v4-1-flash-economy-261017,deepseek-v4-flash-ga-260731,glm-5-3-flash-260828,deepseek-v4-pro-ga-260813,glm-5-2-260617,doubao-seed-evolving
# AI 核验专家（异构复核）：550 万免费池放首位兜底
LLM_VERIFY_MODEL=doubao-seed-evolving
LLM_VERIFY_POOL=doubao-seed-evolving,deepseek-v4-pro-ga-260813,glm-5-3-flash-260828

# ---------- 方案 B：DeepSeek 官方 ----------
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线，须用 deepseek-flash
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled

# ---------- 方案 C：智谱（免费但能力弱） ----------
# LLM_PROVIDER=zhipu
# LLM_API_KEY=你的智谱key
# LLM_MODEL=glm-4-flash

# ---------- 方案 D：其他 OpenAI 兼容（通义/Kimi/自建） ----------
# LLM_PROVIDER=custom
# LLM_API_KEY=xxx
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 通用 ----------
LLM_MAX_TOKENS=8192
PORT=8765

# 兼容说明：老变量 ZHIPU_API_KEY / ZHIPU_MODEL 仍然有效
# 优先级：LLM_* > DEEPSEEK_* > ZHIPU_*
