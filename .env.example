# ============================================================
# 模型配置模板（复制为 .env 后填入真实 key）
#    cp .env.example .env
# ============================================================

# ---------- 方案 A：火山引擎 Ark（当前在用，推荐） ----------
LLM_PROVIDER=custom
LLM_API_KEY=你的火山引擎key（形如 ark-xxxxxxxx-xxxx-...）
LLM_MODEL=deepseek-v4-1-flash-261017
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 关思考模式：实测 3.2s→1.3s，判定质量不变
LLM_THINKING=disabled

# ---------- 方案 B：DeepSeek 官方 ----------
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线，须用 deepseek-flash
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled

# ---------- 方案 C：智谱（免费但能力弱） ----------
# LLM_PROVIDER=zhipu
# LLM_API_KEY=你的智谱key
# LLM_MODEL=glm-4-flash

# ---------- 方案 D：其他 OpenAI 兼容（通义/Kimi/自建） ----------
# LLM_PROVIDER=custom
# LLM_API_KEY=xxx
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 通用 ----------
LLM_MAX_TOKENS=8192
PORT=8765

# 兼容说明：老变量 ZHIPU_API_KEY / ZHIPU_MODEL 仍然有效
# 优先级：LLM_* > DEEPSEEK_* > ZHIPU_*
